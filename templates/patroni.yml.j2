scope: {{ percona_postgresql_cluster_name }}

name: {{ inventory_hostname }}

restapi:
  listen: 0.0.0.0:{{ percona_postgresql_patroni_rest_port }}
  connect_address: {{ inventory_hostname }}:{{ percona_postgresql_patroni_rest_port }}

etcd3:
  hosts:
    - {{ percona_postgresql_etcd_host }}:{{ percona_postgresql_etcd_client_port }}

bootstrap:
  method: initdb

  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10

    postgresql:
      use_pg_rewind: true
      use_slots: true

      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        archive_mode: "on"
        archive_command: 'envdir /etc/wal-g.d/env wal-g wal-push %p'
        restore_command: 'envdir /etc/wal-g.d/env wal-g wal-fetch %f %p'
        archive_timeout: 60

  initdb:
    - encoding: UTF8
    - data-checksums

  pg_hba:
    - local all postgres trust
    - local all all trust
    - host replication {{ percona_postgresql_replica_user }} 0.0.0.0/0 md5
    - host all all 0.0.0.0/0 md5

  users:
    {{ percona_postgresql_admin_username }}:
      password: {{ percona_postgresql_admin_password }}
      options:
        - createrole
        - createdb

postgresql:
  listen: 0.0.0.0:{{ percona_postgresql_pg_port }}

  connect_address: {{ inventory_hostname }}:{{ percona_postgresql_pg_port }}

  data_dir: {{ percona_postgresql_data_dir }}

  bin_dir: /usr/lib/postgresql/{{ percona_postgresql_version }}/bin

  parameters:
    unix_socket_directories: '/var/run/postgresql'

  pg_hba:
    - local all postgres trust
    - local all all trust
    - host replication {{ percona_postgresql_replica_user }} 0.0.0.0/0 md5
    - host all all 0.0.0.0/0 md5

  authentication:
    replication:
      username: {{ percona_postgresql_replica_user }}
      password: {{ percona_postgresql_replica_password }}

    superuser:
      username: {{ percona_postgresql_superuser_username }}
      password: {{ percona_postgresql_superuser_password }}
