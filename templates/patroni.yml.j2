scope: {{ cluster_name }}

name: {{ inventory_hostname }}

restapi:
  listen: 0.0.0.0:{{ patroni_rest_port }}
  connect_address: {{ ansible_default_ipv4.address }}:{{ patroni_rest_port }}

etcd3:
  hosts:
{% for host in groups['etcd'] %}
    - {{ hostvars[host]['inventory_hostname'] }}:{{ etcd_client_port }}
{% endfor %}

bootstrap:
  method: initdb

  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10

    postgresql:
      use_pg_rewind: true
      use_slots: true

      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10

  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: 0.0.0.0:{{ postgres_port }}

  connect_address: {{ ansible_default_ipv4.address }}:{{ postgres_port }}

  data_dir: {{ postgres_data_dir }}

  bin_dir: /usr/lib/postgresql/{{ version }}/bin

  parameters:
    unix_socket_directories: '/var/run/postgresql'

  authentication:
    replication:
      username: {{ replica_user }}
      password: {{ replica_pass }}

    superuser:
      username: postgres
      password: postgres
