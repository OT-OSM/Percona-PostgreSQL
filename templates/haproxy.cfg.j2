global
    log /dev/log local0

defaults
    log global
    mode tcp
    timeout connect 10s
    timeout client 1m
    timeout server 1m

frontend postgres_front
    bind *:{{ haproxy_port }}
    default_backend postgres_back

backend postgres_back
    option httpchk GET /primary
    http-check expect status 200

{% for host in groups['postgres'] %}
    server pg{{ loop.index }} {{ hostvars[host]['inventory_hostname'] }}:{{ postgres_port }} check port {{ patroni_rest_port }}
{% endfor %}

{% if haproxy_stats_enable %}

listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats refresh 10s
    stats show-node
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}

{% endif %}
