global
    log /dev/log local0

defaults
    log global
    mode tcp
    timeout connect 10s
    timeout client 1m
    timeout server 1m

frontend postgres_front
    bind *:{{ haproxy_port }}
    default_backend postgres_back

backend postgres_back
    option httpchk GET /primary
    http-check expect status 200

{% for host in groups['postgres'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ postgres_port }} check port {{ patroni_rest_port }}
{% endfor %}