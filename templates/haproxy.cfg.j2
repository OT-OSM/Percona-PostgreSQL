global
    log /dev/log local0
    log /dev/log local1 notice
    user {{ percona_postgresql_haproxy_user }}
    group {{ percona_postgresql_haproxy_group }}
    maxconn {{ percona_postgresql_haproxy_max_connections }}

defaults
    log global
    mode tcp
    option tcplog

{% if percona_postgresql_haproxy_tcp_keepalive %}
    option tcpka
{% endif %}

{% if percona_postgresql_haproxy_log_health_checks %}
    option log-health-checks
{% endif %}

    retries {{ percona_postgresql_haproxy_retries }}

    timeout connect {{ percona_postgresql_haproxy_timeout_connect }}
    timeout client {{ percona_postgresql_haproxy_timeout_client }}
    timeout server {{ percona_postgresql_haproxy_timeout_server }}
    timeout check {{ percona_postgresql_haproxy_timeout_check }}

frontend {{ percona_postgresql_haproxy_frontend_name }}
    bind *:{{ percona_postgresql_haproxy_port }}
    default_backend {{ percona_postgresql_haproxy_backend_name }}

backend {{ percona_postgresql_haproxy_backend_name }}
    option httpchk GET /primary
    http-check expect status 200

    default-server inter {{ percona_postgresql_haproxy_health_check_interval }} fastinter {{ percona_postgresql_haproxy_health_check_fast_interval }} downinter {{ percona_postgresql_haproxy_health_check_down_interval }} fall {{ percona_postgresql_haproxy_health_check_fall }} rise {{ percona_postgresql_haproxy_health_check_rise }}

{% for host in percona_postgresql_patroni_nodes %}
    server pg{{ loop.index }} {{ host }}:{{ percona_postgresql_pg_port }} check port {{ percona_postgresql_patroni_rest_port }}
{% endfor %}

{% if percona_postgresql_haproxy_stats_enable %}

listen stats
{% if percona_postgresql_haproxy_stats_ssl_enable %}
    bind *:{{ percona_postgresql_haproxy_stats_port }} ssl crt {{ percona_postgresql_haproxy_stats_ssl_cert }}
{% else %}
    bind *:{{ percona_postgresql_haproxy_stats_port }}
{% endif %}
    mode http

    stats enable
    stats hide-version
    stats refresh {{ percona_postgresql_haproxy_stats_refresh }}
    stats show-node

    stats uri {{ percona_postgresql_haproxy_stats_uri }}

    stats realm HAProxy\ Statistics

{% if percona_postgresql_haproxy_stats_user and percona_postgresql_haproxy_stats_password %}
    stats auth {{ percona_postgresql_haproxy_stats_user }}:{{ percona_postgresql_haproxy_stats_password }}
{% endif %}

{% endif %}
