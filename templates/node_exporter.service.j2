[Unit]
Description=Prometheus Node Exporter
After=network.target

[Service]
Type=simple

User={{ percona_postgresql_node_exporter_user }}
Group={{ percona_postgresql_node_exporter_group }}

ExecStart={{ percona_postgresql_node_exporter_binary }}{% for collector in percona_postgresql_node_exporter_collectors %} \
  {{ collector }}{% endfor %}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
