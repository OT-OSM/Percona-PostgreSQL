name: {{ inventory_hostname }}

data-dir: {{ percona_postgresql_etcd_data_dir }}

heartbeat-interval: {{ percona_postgresql_etcd_heartbeat_interval }}

election-timeout: {{ percona_postgresql_etcd_election_timeout }}

listen-peer-urls: http://{{ percona_postgresql_listen_address }}:{{ percona_postgresql_etcd_peer_port }}

listen-client-urls: http://{{ percona_postgresql_listen_address }}:{{ percona_postgresql_etcd_client_port }}

initial-advertise-peer-urls: http://{{ inventory_hostname }}:{{ percona_postgresql_etcd_peer_port }}

advertise-client-urls: http://{{ inventory_hostname }}:{{ percona_postgresql_etcd_client_port }}

initial-cluster: {% for host in percona_postgresql_etcd_hosts %}{{ host }}=http://{{ host }}:{{ percona_postgresql_etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}

initial-cluster-token: etcd-cluster

initial-cluster-state: new

enable-v2: true
