name: {{ inventory_hostname }}

data-dir: {{ percona_postgresql_etcd_data_dir }}

listen-peer-urls: http://0.0.0.0:{{ percona_postgresql_etcd_peer_port }}

listen-client-urls: http://0.0.0.0:{{ percona_postgresql_etcd_client_port }}

initial-advertise-peer-urls: http://{{ inventory_hostname }}:{{ percona_postgresql_etcd_peer_port }}

advertise-client-urls: http://{{ inventory_hostname }}:{{ percona_postgresql_etcd_client_port }}

initial-cluster: {{ percona_postgresql_etcd_host }}=http://{{ percona_postgresql_etcd_host }}:{{ percona_postgresql_etcd_peer_port }}

initial-cluster-token: etcd-cluster

initial-cluster-state: new

enable-v2: true